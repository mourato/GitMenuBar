#!/usr/bin/env bash
# post-merge warning: flag unpublished main/master commits.
# Git runs this after a merge and ignores its exit status, so it only warns.
# Enable with: git config core.hooksPath <directory holding this file>
# <!-- Generated by agent-config; edit the canonical source. -->
set -euo pipefail

[[ ${AGENT_CONFIG_FINISH_TASK:-0} == 1 ]] && exit 0

branch=$(git branch --show-current 2>/dev/null || true)
case "$branch" in
  main|master) ;;
  *) exit 0 ;;
esac

upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || exit 0
ahead=$(git rev-list --count "$upstream..HEAD")
# A fast-forward pull, or a merge already published, has nothing to warn about.
[[ $ahead -gt 0 ]] || exit 0

printf 'post-merge: WARNING %s has %s unpublished commit(s); review and validate before an authorized push\n' \
  "$branch" "$ahead" >&2
exit 0
