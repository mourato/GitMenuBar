#!/usr/bin/env bash
# post-merge finalizer: push main/master, then clean merged disposable worktrees.
# Git invokes this hook after the merge; it does not initiate the merge.
# Enable with: git config core.hooksPath .githooks
# <!-- Generated by agent-config; edit the canonical source. -->
set -euo pipefail

[[ ${AGENT_CONFIG_FINISH_TASK:-0} == 1 ]] && exit 0

branch=$(git branch --show-current 2>/dev/null || true)
case "$branch" in
  main|master) ;;
  *) exit 0 ;;
esac

repo=$(git rev-parse --show-toplevel)
shim="$repo/scripts/cleanup-merged-worktrees.sh"
[[ -f $shim ]] || {
  printf 'post-merge: missing cleanup helper: %s\n' "$shim" >&2
  exit 1
}

env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_INDEX_FILE \
  -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
  git -C "$repo" push

exec bash "$shim" --apply
