<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Local builds sign without a Development Team, so keychain-access-groups
	     cannot live here: macOS kills a signature that declares a restricted
	     entitlement without an authorizing provisioning profile. The group
	     entitlement is ready in GitMenuBar-KeychainAccessGroups.entitlements. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
